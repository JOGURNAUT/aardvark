  "cards": [
    {
      "dot": "cyan",
      "title": "One generator",
      "items": [
        "The five stages are one Python generator yielding typed events",
        "The server re-serialises them without translating, so a new event type reaches the browser unchanged",
        "Three front ends drive the same loop: React, Streamlit, Gradio"
      ]
    },
    {
      "dot": "emerald",
      "title": "What it will not do",
      "items": [
        "Citation markers are mapped back to snippets after generation, so the model can emit a number but not a URL",
        "A marker pointing at nothing is stripped before the answer is shown"
      ]
    },
    {
      "dot": "amber",
      "title": "Budgets, and what they leave behind",
      "items": [
        "At most 6 pages opened per turn, at most 2 per domain",
        "Snippets packed under a token budget with the same per-domain cap",
        "A page returning 200 with no extractable text is reported, not counted as read"
      ]
    },
    {
      "dot": "violet",
      "title": "Continuing a turn",
      "items": [
        "Per-stage latency and the results the cap left unopened are stored with the turn",
        "dig() reopens the next batch without searching again, then re-packs old and new snippets so the caps stay global"
      ]
    }
  ]
